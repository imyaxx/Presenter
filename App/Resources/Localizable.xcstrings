    "menu.profiles.empty.detail" : {
      "comment" : "Popover empty state explanation. profiles.json is a file name and stays untranslated.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiles will be created in Settings in a later version. For now, add them to profiles.json in the profiles folder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профили будут создаваться в Настройках в следующей версии. Пока добавьте их в файл profiles.json в папке профилей."
          }
        }
      }
    },
    "menu.profiles.empty.title" : {
