    "notice.activation.nothingChanged" : {
      "comment" : "Notice after a failed activation. The argument is the name of one setting, for example 'Dock'.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: the current setting could not be read. Nothing was changed."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: не удалось прочитать текущую настройку. Ничего не изменено."
          }
        }
      }
    },
    "notice.activation.partlyUndone" : {
      "comment" : "Notice after a failed activation that could not be fully undone. The argument is the name of one setting, for example 'Dock'.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ could not be applied, and some changes could not be undone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось применить: %@, и часть изменений отменить не удалось."
          }
        }
      }
    },
    "notice.activation.undone" : {
      "comment" : "Notice after a failed activation that was fully undone. The argument is the name of one setting, for example 'Dock'.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ could not be applied. Everything was undone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось применить: %@. Все изменения отменены."
          }
        }
      }
    },
    "notice.automationPermission" : {
      "comment" : "Second line of a failed Dock notice. Use the names of the System Settings sections as shown in that language.",
