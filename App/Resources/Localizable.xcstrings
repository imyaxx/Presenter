    "menu.attention.unreadable" : {
      "comment" : "Popover text when session.json is corrupted or from a newer version.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The session file could not be read. Presenter left it untouched."
